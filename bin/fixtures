#!/usr/bin/env python
import os
import sys

from openforge.db import PgDB
from openforge.db.fixtures import load_fixtures, find_fixtures

import click


@click.command()
@click.option("--alt", default="")
@click.option("--fixture", help="Load only the specified fixture file")
@click.option("--full-replacement", is_flag=True, help="Use full replacement mode (wipes all data)")
@click.option("--dry-run", is_flag=True, help="Preview changes without applying")
@click.option("--update", help="Specify fixture file for incremental update")
@click.option("--compare-only", is_flag=True, help="Show comparison results only")
def main(alt, fixture, full_replacement, dry_run, update, compare_only):
    with PgDB(os.environ) as db:
        with db.pool.connection() as conn:
            if fixture:
                # If fixture is specified, only load that file
                ffiles = [f for f in find_fixtures(alt) if os.path.basename(f) == fixture]
                if not ffiles:
                    sys.stderr.write(f"Fixture {fixture} not found in fixtures directory\n")
                    sys.exit(1)
                load_fixtures(conn, alt, ffiles, incremental=not full_replacement, dry_run=dry_run)
            else:
                # Otherwise load all fixtures
                load_fixtures(conn, alt, incremental=not full_replacement, dry_run=dry_run)


if __name__ == "__main__":
    sys.exit(main())
