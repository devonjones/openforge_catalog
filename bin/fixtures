#!/usr/bin/env python
import os
import sys

from openforge.db import PgDB
from openforge.db.fixtures import load_fixtures

import click


@click.command()
@click.option("--alt", default="")
def main(alt):
    db = PgDB(os.environ)
    with db.pool.connection() as conn:
        load_fixtures(conn, alt)


if __name__ == "__main__":
    sys.exit(main())
