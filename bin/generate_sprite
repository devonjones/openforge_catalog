#!/usr/bin/env python
"""Generate multi-angle sprite sheet for STL file.

This script generates a sprite sheet with 10 isometric camera angles for a
single STL file. Can optionally upload to R2 and update the database.

Usage:
    ./generate_sprite path/to/model.stl
    ./generate_sprite path/to/model.stl --upload --db-update
    ./generate_sprite path/to/model.stl --dry-run
"""

import json
import os
import sys

import click

from openforge.data.io import create_sprite_sheet, get_s3_client, upload_file


@click.command()
@click.argument("stl_file", type=click.Path(exists=True))
@click.option(
    "--tile-size", default=512, type=int, help="Size of each square tile (default 512)"
)
@click.option(
    "--upload", is_flag=True, help="Upload sprite sheet to R2 (requires credentials)"
)
@click.option(
    "--db-update",
    is_flag=True,
    help="Update database with sprite metadata (requires --upload)",
)
@click.option(
    "--dry-run",
    is_flag=True,
    help="Generate sprite locally but don't upload or update database",
)
@click.option("--verbose", is_flag=True, help="Enable verbose output")
@click.option(
    "--output-json",
    is_flag=True,
    help="Output sprite metadata as JSON (for fixture integration)",
)
@click.pass_context
def main(ctx, stl_file, tile_size, upload, db_update, dry_run, verbose, output_json):
    """Generate multi-angle sprite sheet for an STL file.

    STL_FILE: Path to the STL file to process
    """
    # Validate input
    if not stl_file.endswith(".stl"):
        sys.stderr.write("Error: Input file must be an STL file (.stl extension)\n")
        ctx.exit(1)

    if db_update and not upload:
        sys.stderr.write("Error: --db-update requires --upload\n")
        ctx.exit(1)

    if dry_run and (upload or db_update):
        sys.stderr.write(
            "Warning: --dry-run mode, ignoring --upload and --db-update flags\n"
        )
        upload = False
        db_update = False

    # Generate sprite sheet
    if verbose:
        sys.stderr.write(f"Generating sprite sheet for {stl_file}...\n")
        sys.stderr.write(f"Tile size: {tile_size}x{tile_size}\n")

    try:
        sprite_path, sprite_metadata = create_sprite_sheet(stl_file, tile_size)
    except Exception as e:
        sys.stderr.write(f"Error generating sprite sheet: {e}\n")
        if verbose:
            import traceback

            traceback.print_exc()
        ctx.exit(1)

    if verbose:
        sys.stderr.write(f"Sprite sheet generated: {sprite_path}\n")
        grid = f"{sprite_metadata['grid_rows']}x{sprite_metadata['grid_cols']}"
        sys.stderr.write(f"Grid: {grid}\n")
        sys.stderr.write(f"Angles: {len(sprite_metadata['angles'])}\n")

    sprite_url = None

    # Upload to R2
    if upload:
        if verbose:
            sys.stderr.write("Uploading sprite sheet to R2...\n")

        try:
            config = dict(os.environ)
            s3_client = get_s3_client(config)

            # Extract MD5 from file path or generate it
            # For now, use a placeholder - in production this would come from
            # the file scanner which already calculates MD5
            import hashlib

            with open(stl_file, "rb") as f:
                md5 = hashlib.md5(f.read()).hexdigest()

            file_metadata = {"md5": md5}
            sprite_key = upload_file(
                file_metadata, sprite_path, s3_client, "sprites", None, config, verbose
            )
            sprite_url = f"{config.get('FILE_DOMAIN', '')}/{sprite_key}"

            if verbose:
                sys.stderr.write(f"Uploaded to: {sprite_url}\n")

        except KeyError as e:
            sys.stderr.write(f"Error: Missing environment variable: {e}\n")
            sys.stderr.write(
                "Required: CLOUDFLARE_ENDPOINT, AWS_ACCESS_KEY_ID, "
                "AWS_SECRET_ACCESS_KEY\n"
            )
            ctx.exit(1)
        except Exception as e:
            sys.stderr.write(f"Error uploading sprite sheet: {e}\n")
            if verbose:
                import traceback

                traceback.print_exc()
            ctx.exit(1)
    else:
        if verbose:
            sys.stderr.write("Skipping upload (use --upload flag to enable)\n")

    # Update database
    if db_update:
        if verbose:
            sys.stderr.write("Updating database with sprite metadata...\n")

        # TODO: Implement database update
        # This will be implemented when integrating with the scanner pipeline
        sys.stderr.write("Warning: Database update not yet implemented\n")

    # Output sprite metadata as JSON for fixture integration
    if output_json:
        output = {
            "sprite_path": sprite_path,
            "sprite_url": sprite_url,
            "sprite_metadata": sprite_metadata,
        }
        print(json.dumps(output, indent=2))
    else:
        # Human-readable output
        print("Sprite sheet generated successfully!")
        print(f"  Local path: {sprite_path}")
        if sprite_url:
            print(f"  R2 URL: {sprite_url}")
        grid = f"{sprite_metadata['grid_rows']}x{sprite_metadata['grid_cols']}"
        tile = f"{sprite_metadata['tile_size']}x{sprite_metadata['tile_size']}"
        print(f"  Grid: {grid}")
        print(f"  Tile size: {tile}")
        print(f"  Angles: {len(sprite_metadata['angles'])}")
        print(f"  Default angle: {sprite_metadata['default_angle']}")

    # Clean up local file if uploaded
    if upload and os.path.exists(sprite_path):
        if verbose:
            sys.stderr.write(f"Cleaning up local sprite file: {sprite_path}\n")
        os.remove(sprite_path)

    ctx.exit(0)


if __name__ == "__main__":
    sys.exit(main())
